# SynxEx App — Auth0 / SSO Environment Configuration (Client-side)
# Copy to .env or configure in Vercel Project Settings for synxex-app.

# Your Auth0 Tenant Domain (e.g., synxex.us.auth0.com or auth.synxex.com)
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com

# The Client ID of the "Single Page Application" configured in Auth0 Dashboard
VITE_AUTH0_CLIENT_ID=your-auth0-spa-client-id

# Marketing Website URL (for cross-navigation)
VITE_MARKETING_URL=https://synxex-marketing.vercel.app

# Web Application Root URL
VITE_APP_URL=https://synxex-app.vercel.app

